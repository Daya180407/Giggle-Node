# ---------------------------------------------------------------------------
# GigleNode environment
# Copy to `.env.local` for local development, or add these in Vercel → Settings
# → Environment Variables. Never commit a real key.
# ---------------------------------------------------------------------------

# Session cookie signing key. Required in production: use a long random string.
SESSION_SECRET=

# Supabase: persistence for Vercel (serverless has a read-only filesystem).
# Run supabase/schema.sql in the Supabase SQL editor first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: bucket for owner avatars (created by supabase/schema.sql).
SUPABASE_STORAGE_BUCKET=giglenode-media

# Optional email delivery (magic links, notifications). Without these the reset
# link is shown on screen instead of being emailed.
RESEND_API_KEY=
EMAIL_FROM=

# Optional AI search providers.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
